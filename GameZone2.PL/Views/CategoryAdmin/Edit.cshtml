@model CategoryViewModel
@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


<div class="container-fluid pt-5 px-4">
    <div class="bg-secondary rounded h-100 p-5 mt-5 px-5">
        <form asp-action="Edit" method="post" class="bg-secondary rounded h-100 p-4">
            <h6 class="mb-4 text-uppercase">Category</h6>

            <div class="form-floating mb-3">
                <input asp-for="CategoryName" type="text" class="form-control" id="floatingInput">
                <label for="floatingInput">Category Name</label>
            </div>

            <div class="form-floating mb-3">
                <textarea asp-for="Description" class="form-control" id="floatingInput"></textarea>
                <label for="floatingInput">Category Description</label>
            </div>

            <br>

            <button type="submit" class="btn bg-primary text-white">Edit</button>
            <a asp-action="Index" class="btn bg-primary text-white">Back to List</a>
        </form>
    </div>
</div>
