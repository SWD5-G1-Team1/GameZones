
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@model List<CategoryViewModel>
<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <h2>Category List</h2>

        @if (ViewBag.Message != null)
        {
            <div class="alert alert-danger">@ViewBag.Message</div>
        }

        <div class="col-12">
            <div class="filter">
                <a class="icon" href="#" data-bs-toggle="dropdown"><i class="bi bi-three-dots"></i></a>
                <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                    <li class="dropdown-header text-start">
                        <h6>Filter</h6>
                    </li>
                    <li><a class="dropdown-item" href="#">Today</a></li>
                    <li><a class="dropdown-item" href="#">This Month</a></li>
                    <li><a class="dropdown-item" href="#">This Year</a></li>
                </ul>
            </div>
            <div class="bg-secondary rounded h-100 p-4">
                <h6 class="mb-4">Category Table</h6>
                <div class="table-responsive">
                    <table class="table">
                        <thead class="text-primary fs-20 text-uppercase text-center" >
                            <tr>
                                <th >Category Name</th>
                                <th>Description</th>
                                <th>Edit</th>
                                <th>Delete</th>
                            </tr>
                        </thead>
                        <tbody class="text-center">
                            @foreach(var category in Model)
                            {
                                <tr>
                                    <td>@category.CategoryName</td>
                                    <td>@category.Description</td>
                                    <td><a class="btn btn-danger" asp-action="Edit" asp-route-id="@category.Id">Edit</a></td>
                                    <td><button class="btn btn-danger delete-btn"  data-id="@category.Id">Delete</button></td>
                                </tr>
                                
                            }

                        </tbody>
                    </table>
                </div>
            </div>
        </div> <!-- col-12 -->
    </div> <!-- row -->
    <!-- زر إضافة منتج جديد جوا الكونتينر -->
    <div class="mt-5">
        <a href="@Url.Action("Create", "CategoryAdmin")" class="btn text-white bg-primary">Add New Category</a>
    </div>
</div> <!-- container-fluid -->
@section Scripts {
    <script>
        $(document).ready(function () {
            $('.delete-btn').click(function (e) {
                e.preventDefault(); // prevent default <a> behavior if used

                var button = $(this); // reference to the clicked button
                var id = button.data('id');

                Swal.fire({
                    title: 'Are you sure?',
                    text: "This action cannot be undone!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Yes, delete it!',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '/CategoryAdmin/Delete/' + id,
                            type: 'POST',
                            success: function (res) {
                                toastr.success("Deleted successfully");

                                // Remove the row without reloading the page
                                button.closest('tr').fadeOut(300, function () {
                                    $(this).remove();
                                });
                            },
                            error: function () {
                                toastr.error("An error occurred while deleting");
                            }
                        });
                    }
                });
            });
        });
    </script>
}
