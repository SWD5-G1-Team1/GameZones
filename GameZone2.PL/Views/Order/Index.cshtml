
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <h2>Order List</h2>

        @if (ViewBag.Message != null)
        {
            <div class="alert alert-danger">@ViewBag.Message</div>
        }

        <div class="col-12">
            <div class="filter">
                <a class="icon" href="#" data-bs-toggle="dropdown"><i class="bi bi-three-dots"></i></a>
                <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                    <li class="dropdown-header text-start">
                        <h6>Filter</h6>
                    </li>
                    <li><a class="dropdown-item" href="#">Today</a></li>
                    <li><a class="dropdown-item" href="#">This Month</a></li>
                    <li><a class="dropdown-item" href="#">This Year</a></li>
                </ul>
            </div>

            <div class="bg-secondary rounded h-100 p-4">
                <h6 class="mb-4">Category Table</h6>
                <div class="table-responsive">
                    <table class="table">
                        <thead class="text-primary fs-20 text-uppercase text-center">
                            <tr>
                                <th>Order Id</th>
                                <th>Order Status</th>
                                <th>PaymentStatus</th>
                               
                            </tr>
                        </thead>
                        <tbody class="text-center text-white">

                            <tr>
                                <td>#</td>
                                <td >Pending.</td>
                                <td>Unpaid</td>
                            </tr>
                            <tr>
                                <td>#</td>
                                <td>Pending.</td>
                                <td>Unpaid</td>
                            </tr>

                        </tbody>
                    </table>
                </div>
            </div>
        </div> <!-- col-12 -->
    </div> <!-- row -->
    <!-- زر إضافة منتج جديد جوا الكونتينر -->
    @* <div class="mt-5"> *@
    @*     <a href="@Url.Action("Create", "Product")" class="btn text-white bg-primary">Add New Product</a> *@
    @* </div> *@
</div> <!-- container-fluid -->
